# Server environment example
# Copy ke .env dan isi nilai yang sesuai
# Production pakai ecosystem.config.cjs (PM2)

# Base URL backend (BE) - WAJIB
PRIVATE_API_BASE_URL=http://localhost:8080

# Cookie secure flag
# - false: HTTP (development)
# - true: HTTPS (production)
COOKIE_SECURE=false

# Port BFF server
PORT=3000

# API Key untuk akses BE - WAJIB
PRIVATE_API_KEY=your_dev_api_key_here

# Session cookie mode
# - session: cookie tanpa maxAge (hilang saat browser close)
# - persistent: cookie maxAge 1 jam (3600 detik) (default)
SESSION_COOKIE_MODE=persistent